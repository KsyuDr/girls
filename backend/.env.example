# Скопируйте в backend/.env и при необходимости поменяйте
ENVIRONMENT=dev
# DEBUG=true отдаёт клиенту трейсбек ошибки 500 — включайте только для отладки
DEBUG=false
DATABASE_URL=postgresql+asyncpg://safe_city:safe_city@localhost:5433/safe_city
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
JWT_SECRET=dev-only-secret-change-me-in-production-0123456789
SMS_MOCK_CODE=0000
MEDIA_DIR=media
# Лимиты кодов входа (решение 71); значения по умолчанию — в app/core/config.py
# AUTH_CODE_RESEND_SECONDS=60
# AUTH_CODES_PER_PHONE_PER_HOUR=5
# AUTH_CODES_PER_IP_PER_HOUR=30
# AUTH_FAILED_ATTEMPTS_PER_HOUR=10
# Лимиты SOS и меток (решение 113)
# SOS_WITH_SMS_PER_HOUR=5
# SOS_SMS_NUMBERS_PER_DAY=10
# INCIDENTS_PER_HOUR=10
